                error_count=count()
      by trace_id
    | sort by first_seen desc
    | limit 20"
`;

exports[`queries.ts — golden snapshots + invariants > searchLogs > snapshot stable 1`] = `
"dataset="otel"
    | where isnotnull(body) and isnotnull(severity_number) and tostring(resource.attributes['service.name'])=="test-svc" and severity_number >= 17 and tostring(body) contains "connection refused"
    | project _time, trace_id, span_id, body, severity_text, severity_number,
              attributes,
              service_name=tostring(resource.attributes['service.name']),
              pod_name=tostring(resource.attributes['k8s.pod.name']),
              code_file=tostring(attributes['code.file.path']),
              code_function=tostring(attributes['code.function.name']),
              code_line=attributes['code.line.number']
    | sort by _time desc
    | limit 100"
`;

exports[`queries.ts — golden snapshots + invariants > serviceInstances > snapshot stable 1`] = `
"dataset="otel" | where isnotnull(end_time_unix_nano)
    | extend svc=tostring(resource.attributes['service.name']),
            instance_id=tostring(resource.attributes['service.instance.id']),
            dur_us=(toreal(end_time_unix_nano)-toreal(start_time_unix_nano))/1000.0,
            is_error=(tostring(status.code)=="2")
    | where svc=="test-svc"
    | where tostring(kind) in ("2", "5")
    | where dur_us < 30000000
    | summarize requests=count(),
                errors=countif(is_error),
                p50_us=percentile(dur_us, 50),
                p95_us=percentile(dur_us, 95),
                p99_us=percentile(dur_us, 99)
      by instance_id
    | extend error_rate=toreal(errors)/toreal(requests)
    | sort by requests desc"
`;

exports[`queries.ts — golden snapshots + invariants > serviceMetricDelta > snapshot stable 1`] = `
"dataset="otel" | where datatype == "generic_metrics"
    | where isnotnull(['k8s.container.restarts'])
    | extend svc=tostring(['service.name']),
             dep=tostring(['k8s.deployment.name']),
             pod=tostring(['k8s.pod.name']),
             container=tostring(['k8s.container.name'])
    | where svc == "test-svc" or dep == "test-svc"
    | summarize d=max(toreal(['k8s.container.restarts']))-min(toreal(['k8s.container.restarts']))
      by pod, container
    | summarize delta=sum(d)"
`;

