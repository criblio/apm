            dur_ms=(toreal(end_time_unix_nano)-toreal(start_time_unix_nano))/1000000.0,
            _time=bin(_time, 1m)
    | where isnotempty(svc) and dur_ms >= 0
    | where tostring(kind) in ("2", "5")
    | where substring(tolower(tostring(span_id)), 0, 1) in ("0", "1", "2", "3")
    | where dur_us < 30000000
