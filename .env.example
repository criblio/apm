# Cribl APM — local environment
#
# Copy to .env and fill in values. .env is gitignored.

# ---- Cribl Cloud workspace (used by scripts/deploy.mjs + Playwright tests) ----
CRIBL_BASE_URL=https://your-workspace.cribl-staging.cloud/
CRIBL_CLIENT_ID=
CRIBL_CLIENT_SECRET=

# ---- Playwright tests (tests/auth.setup.ts) ----
# Used by the auth setup fixture to log in to Cribl Cloud via Auth0 and
# cache browser state to playwright/.auth/cribl-cloud.json.
CRIBL_TEST_EMAIL=
CRIBL_TEST_PASSWORD=
# Optional: override the path the pack UI is mounted at inside the workspace.
# Defaults to /app-ui/apm/ which matches the Cribl App Platform convention.
# CRIBL_APM_APP_PATH=/app-ui/apm/

# ---- flagd-ui (used by scripts/flagd-set.sh) ----
# Point at the flagd-ui sidecar in the demo cluster's flagd pod.
# Easiest path is a kubectl port-forward:
#   kubectl -n otel-demo port-forward --address 0.0.0.0 svc/flagd 4000:4000 &
FLAGD_UI_URL=http://localhost:4000

# ---- Cribl MCP Server (scripts/cribl-mcp.sh) ----
# Optional: require an API key on requests to the local MCP server. Leave
# blank for unauthenticated localhost-only access (fine for dev).
# CRIBL_MCP_API_KEY=

# ---- Server-side investigations trigger (scripts/provision.ts) ----
# When server investigations is on, the alert-notify search fires a
# webhook target at the investigator cell. These two let
# `SERVER_INVESTIGATIONS=true npm run provision` create that target
# (you can also provision from the Settings UI).
#
# SERVER_INVESTIGATIONS stays commented — it's a per-run toggle, not a
# default. The app-scoped KV flag is unreadable from the CLI, so pass
# this only when you want the deploy to create (=true) or remove
# (=false) the trigger. Unset ⇒ the deploy leaves the trigger as-is.
# SERVER_INVESTIGATIONS=true
CELL_URL=              # the cell's public host, e.g. https://54-71-34-177.sslip.io
CELL_WEBHOOK_BEARER=   # matches the cell's SSM /apm-cell/WEBHOOK_BEARER (its /alerts/fire bearer)
CELL_UI_BEARER=        # the cell's UI_BEARER (= the app's cellToken); lets provisioning push
                       # the Settings source repos to the cell for alert-fired investigations
