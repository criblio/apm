{
  "name": "apm",
  "private": true,
  "version": "0.11.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "package": "npm run build && node scripts/package.mjs",
    "verify": "npm run lint && npm test && npx tsc --noEmit",
    "audit": "npm audit --audit-level=moderate && npm audit --omit=dev --audit-level=low",
    "security:static": "node scripts/check-actions-pinned.mjs && node scripts/check-licenses.mjs && node scripts/secret-scan.mjs",
    "release:evidence": "node scripts/release-artifacts.mjs",
    "inspect:pack": "node scripts/inspect-pack.mjs",
    "deploy": "node scripts/deploy.mjs",
    "provision": "tsx scripts/provision.ts",
    "browser:smoke": "node scripts/browser-smoke.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "eval": "tsx eval/run.ts"
  },
  "dependencies": {
    "@capra/core": "^1.5.0",
    "@capra/icons": "^1.6.0",
    "@capra/theme": "^1.2.0",
    "@cribl/app-utils": "file:../cribl-search-app-framework/packages/app-utils",
    "d3-array": "^3.2.4",
    "d3-force": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-time": "^3.1.0",
    "d3-time-format": "^4.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@capra/dx-tokens-postcss-plugin": "^0.3.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@types/d3-array": "^3.2.2",
    "@types/d3-force": "^3.0.10",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-shape": "^3.1.8",
    "@types/d3-time": "^3.0.4",
    "@types/d3-time-format": "^4.0.3",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "playwright-core": "^1.59.1",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "displayName": "Cribl APM",
  "description": "Application performance monitoring on top of Cribl Search — traces, logs, and metrics from the OpenTelemetry demo.",
  "author": "Clint Sharp",
  "cribl": {
    "type": "app",
    "createAppScriptVersion": "0.3.0"
  }
}
