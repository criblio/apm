{
  "name": "apm",
  "private": true,
  "version": "0.14.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "package": "npm run build && cribl-app-package",
    "verify": "npm run lint && npm test && npx tsc --noEmit",
    "audit": "node scripts/audit.mjs",
    "security:static": "cribl-app-security",
    "release:evidence": "cribl-app-release-evidence --proxies-manifest config/proxies.expected.yml",
    "inspect:pack": "cribl-app-inspect --proxies-manifest config/proxies.expected.yml",
    "deploy": "cribl-app-deploy --proxies-manifest config/proxies.expected.yml --require-no-policies",
    "provision": "tsx scripts/provision.ts",
    "browser:smoke": "node scripts/browser-smoke.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "eval": "tsx eval/run.ts"
  },
  "dependencies": {
    "@capra/core": "^1.13.0",
    "@capra/icons": "^1.6.0",
    "@capra/theme": "^1.5.0",
    "@criblio/agent-protocol": "^0.1.1",
    "@criblio/app-utils": "^0.5.1",
    "@criblio/cell-harness": "^0.1.1",
    "@criblio/cell-workspace": "^0.1.1",
    "d3-array": "^3.2.4",
    "d3-force": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-time": "^3.1.0",
    "d3-time-format": "^4.1.0",
    "highlight.js": "^11.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@capra/dx-tokens-postcss-plugin": "^0.4.0",
    "@criblio/app-tooling": "^0.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/d3-array": "^3.2.2",
    "@types/d3-force": "^3.0.10",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-time": "^3.0.4",
    "@types/d3-time-format": "^4.0.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "playwright-core": "^1.59.1",
    "tsx": "^4.23.12",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "displayName": "Cribl APM",
  "description": "Application performance monitoring on top of Cribl Search \u2014 traces, logs, and metrics from the OpenTelemetry demo.",
  "author": "Clint Sharp",
  "cribl": {
    "type": "app",
    "createAppScriptVersion": "0.3.0"
  }
}
